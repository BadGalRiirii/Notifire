# Copy to backend/.env for local development. In production (Render) set these
# in the dashboard instead — see DEPLOYMENT.md.

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=192.168.100.89,localhost,127.0.0.1

# Supabase Postgres — Dashboard > Connect > "Session pooler" connection string.
# Leave blank to use local SQLite (db.sqlite3).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Email codes (verification / password reset) via Gmail.
# Needs 2-Step Verification on the Google account and an App Password.
# Leave blank to print emails to the server console instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Or email through Brevo's HTTPS API (needed on Render's free plan, which
# blocks SMTP). When BREVO_API_KEY is set it is used instead of Gmail SMTP.
BREVO_API_KEY=
NOTIFIRE_EMAIL_SENDER=

# Secret header for /api/internal/check-offline/ (external scheduler).
NOTIFIRE_CRON_SECRET=

# Push notifications (Firebase Cloud Messaging): path to the service-account
# JSON file (or put the JSON itself in FIREBASE_CREDENTIALS_JSON).
FIREBASE_CREDENTIALS=
FIREBASE_CREDENTIALS_JSON=
# Optional Realtime Database mirror of readings
FIREBASE_DATABASE_URL=

# Optional error tracking (sentry.io → project → Client Keys (DSN))
SENTRY_DSN=

# Production only (Render sets these): HTTPS redirect + HSTS, DB connection reuse
# NOTIFIRE_FORCE_HTTPS=1
# DB_CONN_MAX_AGE=60
