# Copy to .env (or export in your shell) — all optional for local dev.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Firebase mirroring (optional — leave blank to run fully local on SQLite)
FIREBASE_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
